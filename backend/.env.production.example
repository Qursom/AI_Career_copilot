# =============================================================================
# Render (Docker API) — production template
# Copy keys into Render → Environment. Do not commit a filled copy.
# Omit PORT — Render injects it. Health: /api/v1/health
# =============================================================================

NODE_ENV=production
API_PREFIX=api
LOG_FORMAT=json
LOG_LEVEL=log

# Vercel origin, https, no trailing slash. Comma-separate if you have a custom domain too.
CORS_ORIGIN=https://YOUR-APP.vercel.app
FRONTEND_URL=https://YOUR-APP.vercel.app

# Required: Vercel UI and Render API are different sites.
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_DOMAIN=
SESSION_TTL_SECONDS=604800

AUTH_DEV_BYPASS=false
ALLOW_MOCK_LLM=false

# --- LLM (mock is refused in production unless ALLOW_MOCK_LLM=true) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=30000

# --- Data ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/career_copilot?retryWrites=true&w=majority

# Upstash → REST API (sessions + cache). Prefer these over REDIS_URL on Render.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=86400
RESUME_QUEUE_ENABLED=false
RESUME_QUEUE_WORKER=true

# --- Firebase Admin (JSON file path does not work on Render) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nKEEP_THE_NEWLINE_ESCAPES\n-----END PRIVATE KEY-----\n"

# --- RAG (optional; set RAG_ENABLED=false if Qdrant is not ready) ---
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=gemini
QDRANT_URL=https://YOUR-CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=career_copilot_skills

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30
RESUME_COIN_COST=10
JOB_MATCH_COIN_COST=10
USER_STARTING_COINS=20
RESUME_MAX_FILE_SIZE_MB=20
RESUME_ANALYSIS_MAX_RETRIES=2

SENTRY_DSN=

# Stripe (leave empty until checkout is live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COIN_PACKS=
