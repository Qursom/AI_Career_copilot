NODE_ENV=development
# Local default 3001. On Render, omit PORT — the platform sets it.
PORT=3001
API_PREFIX=api

# Credentialed CORS allowlist (comma-separated). Production must be the real UI origin, not *.
CORS_ORIGIN=http://localhost:3000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

LOG_LEVEL=log

# --- LLM (chat / JSON) ---
# mock | gemini | groq
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=30000

# --- RAG / Qdrant ---
RAG_ENABLED=true
# mock | gemini. Must match what the collection was ingested with: changing it
# without re-running "npm run rag:ingest" makes retrieval return nothing.
# `gemini` requires GEMINI_API_KEY and refuses to boot without it.
RAG_EMBEDDING_PROVIDER=mock
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud. Leave empty for local Docker (no auth).
QDRANT_API_KEY=
QDRANT_COLLECTION=career_copilot_skills

# --- Mongo / cache ---
MONGODB_URI=
# Optional local Redis (Docker). Ignored for sessions/cache when Upstash REST is set.
REDIS_URL=redis://localhost:6379
# Upstash console → REST API → copy these two (used on Render for sessions/cache).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_CACHE_TTL_SECONDS=86400
SESSION_TTL_SECONDS=604800
# Opt-in BullMQ: 202 + jobId, poll GET /resume/status/:jobId. Default off.
RESUME_QUEUE_ENABLED=false
# Only used when RESUME_QUEUE_ENABLED=true. false = enqueue without a worker.
RESUME_QUEUE_WORKER=true

# --- Auth ---
# Accepts an `x-user-id` header as the caller's identity so the API is usable
# without Firebase keys. Keep this false unless you are running locally: it is
# arbitrary account impersonation. The guard also refuses it when NODE_ENV is
# production or when Firebase Admin is configured.
AUTH_DEV_BYPASS=false

# --- Firebase Admin (never expose these to the frontend) ---
# Prefer the downloaded service-account JSON (path is relative to /backend).
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

RESUME_COIN_COST=10
JOB_MATCH_COIN_COST=10
USER_STARTING_COINS=20
RESUME_MAX_FILE_SIZE_MB=20
RESUME_ANALYSIS_MAX_RETRIES=2

# Cookie Domain when API and UI share a parent domain (e.g. .example.com).
SESSION_COOKIE_DOMAIN=
# Public site origin for Stripe return URLs.
FRONTEND_URL=http://localhost:3000
# Production-only: allow LLM_PROVIDER=mock on a staging deploy.
ALLOW_MOCK_LLM=false
LOG_FORMAT=pretty
SENTRY_DSN=

# Stripe coin packs (leave empty to show packs in the UI with checkout off).
# When you are ready: Test mode API key, webhook secret from `stripe listen`
# or Dashboard, and price IDs:
# STRIPE_COIN_PACKS=starter:price_xxx:50,plus:price_yyy:200,pro:price_zzz:500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COIN_PACKS=
