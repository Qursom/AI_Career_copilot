NODE_ENV=development
PORT=3001
API_PREFIX=api

CORS_ORIGIN=http://localhost:3000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

LOG_LEVEL=log

# --- LLM (chat / JSON) ---
# mock: no paid APIs. gemini: set GEMINI_API_KEY.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Reserved for a future vector store. Retrieval currently returns empty context.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
LLM_TIMEOUT_MS=30000

# Optional: set to 1 with GEMINI_API_KEY to enable the live API test in
# src/llm/providers/gemini.provider.spec.ts (not run in default CI).
# GEMINI_LIVE_TEST=1

# --- RAG ---
# Retrieval returns empty context until a vector store is wired in.
# RAG_ENABLED=false and "no store" behave the same (empty context).
# rag:ingest logs a skip message (does not error).
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=gemini
