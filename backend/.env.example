NODE_ENV=development
PORT=3001
API_PREFIX=api

CORS_ORIGIN=http://localhost:3000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

LOG_LEVEL=log

# --- LLM (chat / JSON) ---
# mock | gemini | groq
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=30000

# --- RAG / Qdrant ---
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=mock
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=career_copilot_skills

# --- Mongo / Redis ---
MONGODB_URI=
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=86400
SESSION_TTL_SECONDS=604800

# --- Firebase Admin (never expose these to the frontend) ---
# Prefer the downloaded service-account JSON (path is relative to /backend).
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

RESUME_COIN_COST=10
USER_STARTING_COINS=100
